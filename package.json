{
  "name": "lampa-home",
  "version": "0.1.0",
  "description": "Lampa plugin: home screen with curated rows",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --target=es2019 --loader:.css=text --outfile=lampa-home.js",
    "test": "node --test \"test/**/*.test.js\"",
    "serve": "node dev/serve.cjs",
    "dev:fetch": "git clone --depth 1 https://github.com/yumata/lampa-source .lampa-source",
    "release": "npm run build && git add lampa-home.js && git commit -m \"build: lampa-home.js\" && git push"
  },
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
